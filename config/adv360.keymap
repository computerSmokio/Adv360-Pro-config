#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        nvim_lux: nvim_lux {
            compatible = "zmk,behavior-hold-tap";
            label = "NVIM_LUX";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            quick-tap-ms = <250>;
        };
    };

    macros {
        half_circle_forwadD: half_circle_forwadD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp D &kp D>;
            label = "HALF_CIRCLE_FORWADD";
        };

        qa_vim: qa_vim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp Q &kp A>;
            label = "QA_VIM";
        };

        write_vim: write_vim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp W>;
            label = "WRITE_VIM";
        };

        half_circle_back: half_circle_back {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp A &kp A>;
            label = "HALF_CIRCLE_BACK";
        };

        downdown: downdown {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp N0 &kp S>;
            label = "DOWNDOWN";
        };

        f_down_forward: f_down_forward {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp S &kp D &kp D>;
            label = "F_DOWN_FORWARD";
        };

        back_down_back: back_down_back {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp S &kp A &kp A>;
            label = "BACK_DOWN_BACK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colemak-DHM {
            display-name = "normal";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &to 4                                                                        &mo 8      &kp N6  &kp N7  &kp N8     &kp N9      &kp N0         &kp MINUS
&kp TAB    &kp Q      &kp W     &kp F     &kp P      &kp B   &to 0                                                                        &to 2      &kp J   &kp L   &kp U      &kp Y       &kp SEMICOLON  &kp BSLH
&kp ESC    &kp A      &kp R     &kp S     &kp T      &kp G   &to 1                  &kp LCTRL  &kp LALT      &kp LGUI          &kp RCTRL  &to 6      &kp M   &kp N   &kp E      &kp I       &kp O          &kp SQT
&kp LSHFT  &kp X      &kp C     &kp D     &kp V      &kp Z                                     &kp HOME      &kp PG_UP                               &kp K   &kp H   &kp COMMA  &kp PERIOD  &kp SLASH      &kp RSHFT
&mo 9      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &nvim_lux 6 BACKSPACE  &kp DEL    &kp END       &kp LEFT_CONTROL  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp KP_DOT  &kp RBKT       &mo 9
            >;

            label = "normal";
        };

        low-key-QWERTY {
            display-name = "normal";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 4                                                                                     &mo 8      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &to 0                                                                                      &to 2      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &to 1                  &kp LEFT_CONTROL  &kp LALT      &kp LGUI          &kp LEFT_CONTROL  &to 3      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                                            &kp HOME      &kp PG_UP                                      &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 9      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &nvim_lux 6 BACKSPACE  &kp DEL           &kp END       &kp LEFT_CONTROL  &kp ENTER         &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 9
            >;
        };

        Colemak-DHM-mac {
            label = "mac";
            display-name = "mac";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &to 4                                                                     &mo 8      &kp N6  &kp N7  &kp N8     &kp N9      &kp N0         &kp MINUS
&kp TAB    &kp Q      &kp W     &kp F     &kp P      &kp B   &to 0                                                                     &to 2      &kp J   &kp L   &kp U      &kp Y       &kp SEMICOLON  &kp BSLH
&kp ESC    &kp A      &kp R     &kp S     &kp T      &kp G   &to 1                  &kp LCTRL  &kp LALT      &kp LGUI       &kp RCTRL  &to 6      &kp M   &kp N   &kp E      &kp I       &kp O          &kp SQT
&kp LSHFT  &kp X      &kp C     &kp D     &kp V      &kp Z                                     &kp HOME      &kp PG_UP                            &kp K   &kp H   &kp COMMA  &kp PERIOD  &kp SLASH      &kp RSHFT
&mo 9      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &nvim_lux 6 BACKSPACE  &kp DEL    &kp END       &kp RIGHT_ALT  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp KP_DOT  &kp RBKT       &mo 9
            >;
        };

        low-key-QWERTY-mac {
            display-name = "mac";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 4                                                                                  &mo 8      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &to 0                                                                                   &to 2      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &to 1                  &kp LEFT_CONTROL  &kp LALT      &kp LGUI       &kp LEFT_CONTROL  &to 3      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                                            &kp HOME      &kp PG_UP                                   &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 9      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &nvim_lux 6 BACKSPACE  &kp DEL           &kp END       &kp RIGHT_ALT  &kp ENTER         &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 9
            >;
        };

        SF6 {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                                 &trans     &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &to 0                                                                  &to 2      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &to 1      &kp LEFT_CONTROL  &kp LALT      &kp LGUI   &lt 6 RIGHT_ALT  &to 3      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                                &kp I         &kp PG_UP                              &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 9      &kp GRAVE  &kp CAPS  &kp LEFT  &kp LCTRL          &kp SPACE  &kp LEFT_ALT      &kp H         &kp PG_DN  &kp ENTER        &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 9
            >;
        };

        fn {
            display-name = "fn_normal";
            bindings = <
&kp F1      &kp NUMBER_1  &kp NUMBER_2          &kp NUMBER_3      &kp NUMBER_4          &kp N5         &tog 6                                      &mo 8   &kp NUMBER_6      &kp N7           &kp N8             &kp N9                 &kp N0                &kp F12
&write_vim  &kp AT_SIGN   &kp GRAVE             &kp QUESTION      &kp DOUBLE_QUOTES     &kp PERCENT    &none                                       &none   &kp LC(Y)         &kp LC(L)        &kp LC(K)          &kp LC(J)              &trans                &trans
&trans      &kp TILDE     &kp PIPE              &kp DOLLAR        &kp LEFT_PARENTHESIS  &kp DOLLAR     &none   &trans  &trans      &trans  &trans  &none   &kp H             &kp J            &kp K              &kp L                  &kp COLON             &kp LC(LS(V))
&mo 6       &kp SLASH     &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp LEFT_BRACE        &kp LESS_THAN                  &trans      &trans                  &kp GREATER_THAN  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp NON_US_BACKSLASH  &kp LC(LS(C))
&qa_vim     &trans        &trans                &trans            &trans                               &trans  &trans  &trans      &trans  &trans  &trans                    &trans           &trans             &trans                 &trans                &trans
            >;
        };

        fn_shift {
            display-name = "fn_shift";
            bindings = <
&kp F1      &kp NUMBER_1   &kp NUMBER_2          &kp NUMBER_3     &kp NUMBER_4           &kp N5       &tog 6                                      &mo 8   &kp NUMBER_6  &kp N7    &kp N8          &kp N9  &kp N0     &kp F12
&write_vim  &kp GRAVE      &kp SINGLE_QUOTE      &kp EXCLAMATION  &kp SQT                &kp PERCENT  &none                                       &none   &kp LC(Y)     &trans    &kp LC(U)       &trans  &trans     &trans
&trans      &kp PERCENT    &kp HASH              &kp CARET        &kp RIGHT_PARENTHESIS  &kp DOLLAR   &none   &trans  &trans      &trans  &trans  &none   &kp H         &kp J     &kp K           &kp L   &kp COLON  &kp LC(LS(V))
&trans      &kp BACKSLASH  &kp NON_US_BACKSLASH  &kp RIGHT_BRACE  &kp RIGHT_BRACKET      &kp CARET                    &trans      &trans                  &trans        &kp PLUS  &kp UNDERSCORE  &trans  &trans     &kp LC(LS(C))
&qa_vim     &trans         &trans                &trans           &trans                              &trans  &trans  &trans      &trans  &trans  &trans                &trans    &trans          &trans  &trans     &trans
            >;
        };

        fn_mac {
            display-name = "fn_mac";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp H   &kp J   &kp K   &kp L   &kp COLON  &kp LG(V)
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans     &kp LG(C)
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans     &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                                          &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL
&trans  &trans        &trans        &trans        &trans        &trans        &trans                                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans      &bt BT_CLR  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans                        &trans      &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans                      &trans  &trans  &trans      &trans      &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        border_keys {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7                                      &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &kp F13  &kp F14
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans   &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans   &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans   &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans   &trans   &trans   &trans   &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        fn_mac {
            if-layers = <6 6>;
            then-layer = <8>;
        };

        fn_mac_qwerty {
            if-layers = <6 6>;
            then-layer = <8>;
        };
    };
};
