#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        low-key-QWERTY {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                &mo 4        &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &to 1                                                                 &none        &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LEFT_CONTROL  &kp LALT      &kp LGUI   &lt 3 RIGHT_ALT  &none        &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                               &kp HOME      &kp PG_UP                                &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL           &kp END       &kp PG_DN  &kp ENTER        &lt 3 SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 3
            >;
        };

        Colemak-DHM {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1       &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 4        &kp N6  &kp N7  &kp N8       &kp N9       &kp N0         &kp MINUS
&kp TAB    &kp Q        &kp W     &kp F     &kp P      &kp B   &none                                                    &none        &kp J   &kp L   &mt GRAVE U  &kp Y        &kp SEMICOLON  &kp BSLH
&kp ESC    &mt GRAVE A  &kp R     &kp S     &kp T      &kp G   &to 0     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none        &kp M   &kp N   &mt GRAVE E  &mt GRAVE I  &mt GRAVE O    &kp SQT
&kp LSHFT  &kp X        &kp C     &kp D     &kp V      &kp Z                        &kp HOME      &kp PG_UP                          &kp K   &kp H   &kp COMMA    &kp PERIOD   &kp SLASH      &kp RSHFT
&mo 3      &kp GRAVE    &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &lt 3 SPACE          &kp UP  &kp DOWN     &kp KP_DOT   &kp RBKT       &mo 3
            >;
        };

        SF6 {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                              &mo 4      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                               &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none   &kp LEFT_CONTROL  &kp LALT      &kp LGUI   &lt 3 RIGHT_ALT  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                             &kp HOME      &kp PG_UP                              &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp N0  &kp DEL           &kp END       &kp PG_DN  &kp ENTER        &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 3
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2                 &kp F3                &kp F4             &kp F5            &kp F6       &tog 1                                      &mo 4   &kp F7  &kp F8     &kp F9     &kp F10  &kp F11     &kp F12
&trans  &kp GRAVE              &kp SINGLE_QUOTE      &kp DOUBLE_QUOTES  &kp TILDE         &kp PERCENT  &none                                       &none   &trans  &trans     &trans     &trans   &trans      &trans
&trans  &kp RIGHT_PARENTHESIS  &kp LEFT_PARENTHESIS  &kp RIGHT_BRACKET  &kp LEFT_BRACKET  &kp DOLLAR   &none   &trans  &trans      &trans  &trans  &none   &kp H   &kp J      &kp K      &kp L    &kp DOLLAR  &trans
&trans  &kp BACKSLASH          &kp SLASH             &kp RIGHT_BRACE    &kp LEFT_BRACE    &kp CARET                    &trans      &trans                  &trans  &kp EQUAL  &kp MINUS  &trans   &trans      &trans
&trans  &trans                 &trans                &trans             &trans                         &trans  &trans  &trans      &trans  &trans  &trans          &trans     &trans     &trans   &trans      &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
